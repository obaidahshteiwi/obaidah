# Copy to .env on the server; NEVER commit the real .env file.
# Example domain: YOUR_PUBLIC_IP.nip.io (replace YOUR_PUBLIC_IP with the VM's public IPv4)
API_DOMAIN=YOUR_PUBLIC_IP.nip.io

# Use long random values. Keep these private.
EVOLUTION_API_KEY=REPLACE_WITH_LONG_RANDOM_API_KEY
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_REDIS_PASSWORD
